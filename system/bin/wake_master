#!/system/bin/sh
# ================================================================
# Galaxy Wake Master - Daemon & Guardian Engine
# Author: hoc
# ================================================================

MODDIR="/data/adb/modules/galaxy_wake_master"
CFG_FILE="/data/adb/galaxy_wake_master.cfg"
DEFAULT_CFG="$MODDIR/default.cfg"
LOG_FILE="/data/local/tmp/galaxy_wake_master.log"
PID_FILE="/data/local/tmp/galaxy_wake_master.pid"
SENSOR_CACHE="/data/local/tmp/wake_sensor.tmp"
DEX_FILE="$MODDIR/wake_sensor.dex"

# Fallback defaults
VOL_UP_WAKE=1
VOL_DOWN_WAKE=1
DROP_VOL_ON_WAKE=1
HEADSET_HOOK_WAKE=0
PUT_DOWN_SLEEP=1
FACE_DOWN_SLEEP=1
POCKET_SLEEP=1
FLAT_TABLE_SLEEP=0
SLEEP_DELAY=2
HW_SYSFS_WAKE=1
VIBRATE_FEEDBACK=1
WEB_PORT=8096

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

load_config() {
    if [ ! -f "$CFG_FILE" ] && [ -f "$DEFAULT_CFG" ]; then
        cp -f "$DEFAULT_CFG" "$CFG_FILE" 2>/dev/null
    fi
    if [ -f "$CFG_FILE" ]; then
        . "$CFG_FILE" 2>/dev/null
    fi
}

# Apply Hardware & Sysfs Wakeup Pins
apply_hw_wakeup() {
    if [ "$HW_SYSFS_WAKE" != "1" ]; then
        return 0
    fi

    # 1. Samsung sec_key kernel driver wakeup keys (Power 116, Home 172, VolDown 114, VolUp 115)
    if [ -f /sys/class/sec/sec_key/wakeup_keys ]; then
        echo "114,115,116,172" > /sys/class/sec/sec_key/wakeup_keys 2>/dev/null
        log_msg "Samsung sec_key wakeup_keys set to 114,115,116,172"
    fi

    # 2. Kernel input wakeup sources & keypad power
    if [ -f /sys/devices/platform/10010000.kp/power/control ]; then
        echo "on" > /sys/devices/platform/10010000.kp/power/control 2>/dev/null
    fi
    for w in /sys/class/input/input*/device/power/wakeup \
             /sys/class/input/input*/power/wakeup \
             /sys/devices/platform/*kpd*/power/wakeup \
             /sys/devices/platform/*gpio*keys*/power/wakeup; do
        if [ -f "$w" ]; then
            echo "enabled" > "$w" 2>/dev/null
        fi
    done
}

# Haptic feedback
trigger_vibrate() {
    [ "$VIBRATE_FEEDBACK" != "1" ] && return
    dur=${1:-40}
    if [ -f /sys/class/timed_output/vibrator/enable ]; then
        echo "$dur" > /sys/class/timed_output/vibrator/enable 2>/dev/null
    elif [ -f /sys/class/sec/vibrator/vibrator_enable ]; then
        echo "$dur" > /sys/class/sec/vibrator/vibrator_enable 2>/dev/null
    else
        cmd vibrator vibrate "$dur" 2>/dev/null || true
    fi
}

# Check if screen is currently ON
is_screen_on() {
    if dumpsys power 2>/dev/null | grep -q "mWakefulness=Awake"; then
        return 0
    fi
    if dumpsys display 2>/dev/null | grep -q "mScreenState=ON"; then
        return 0
    fi
    if dumpsys window 2>/dev/null | grep -q "mScreenOn=true"; then
        return 0
    fi
    return 1
}

# Read live sensor cache written by WakeSensor DEX
read_cached_sensor() {
    key="$1"
    if [ -f "$SENSOR_CACHE" ]; then
        grep -o "${key}=[^;]*" "$SENSOR_CACHE" | head -n1 | cut -d= -f2 | tr -d '\r\n'
    fi
}

# Volume event compensation
compensate_vol() {
    key_type="$1"
    [ "$DROP_VOL_ON_WAKE" != "1" ] && return

    usleep 120000 2>/dev/null || sleep 0.12
    if [ "$key_type" = "UP" ]; then
        cmd media_session volume --stream 3 --adj -1 2>/dev/null || true
    elif [ "$key_type" = "DOWN" ]; then
        cmd media_session volume --stream 3 --adj 1 2>/dev/null || true
    fi
}

# Wake Screen Trigger
trigger_wake() {
    key_source="${1:-Daemon}"
    log_msg "Wake triggered by $key_source"
    input keyevent 224 2>/dev/null || input keyevent 26 2>/dev/null
    trigger_vibrate 35
}

# Sleep Screen Trigger
trigger_sleep() {
    reason="${1:-Put-Down}"
    log_msg "Sleep triggered: $reason"
    input keyevent 223 2>/dev/null || input keyevent 26 2>/dev/null
    trigger_vibrate 60
}

# Worker 1: Real-time Key Event Listener via getevent
run_key_listener() {
    log_msg "Starting real-time key event listener..."
    
    getevent -l 2>/dev/null | while read -r dev type code value; do
        case "$type" in
            *EV_KEY*)
                case "$value" in
                    *DOWN*)
                        case "$code" in
                            *KEY_VOLUMEUP*)
                                if ! is_screen_on; then
                                    load_config
                                    if [ "$VOL_UP_WAKE" = "1" ]; then
                                        trigger_wake "Volume UP"
                                        compensate_vol "UP" &
                                    fi
                                fi
                                ;;
                            *KEY_VOLUMEDOWN*)
                                if ! is_screen_on; then
                                    load_config
                                    if [ "$VOL_DOWN_WAKE" = "1" ]; then
                                        trigger_wake "Volume DOWN"
                                        compensate_vol "DOWN" &
                                    fi
                                fi
                                ;;
                            *KEY_HEADSETHOOK*|*KEY_MEDIA*)
                                if ! is_screen_on; then
                                    load_config
                                    if [ "$HEADSET_HOOK_WAKE" = "1" ]; then
                                        trigger_wake "Headset Media Key"
                                    fi
                                fi
                                ;;
                        esac
                        ;;
                esac
                ;;
        esac
    done
}

# Start full daemon
daemon_run() {
    echo $$ > "$PID_FILE"
    load_config
    apply_hw_wakeup
    log_msg "Galaxy Wake Master Daemon started (PID: $$)"

    # Spawn WakeSensor DEX daemon (handles Accelerometer & Proximity put-down sleep)
    DEX="$DEX_FILE"
    [ ! -f "$DEX" ] && DEX="/data/local/tmp/wake_sensor.dex"
    if [ -f "$DEX" ]; then
        pkill -f "com.galaxy.WakeSensor" 2>/dev/null || true
        nohup app_process -Djava.class.path="$DEX" /system/bin com.galaxy.WakeSensor >> "$LOG_FILE" 2>&1 &
        SENSOR_PID=$!
        log_msg "WakeSensor DEX engine launched (PID: $SENSOR_PID)"
    else
        log_msg "WARNING: wake_sensor.dex not found at $DEX"
    fi

    # Run key listener in foreground of daemon
    run_key_listener

    # Cleanup on exit
    kill -9 "$SENSOR_PID" 2>/dev/null || true
    pkill -f "com.galaxy.WakeSensor" 2>/dev/null || true
    rm -f "$PID_FILE"
}

# Main CLI dispatch
case "$1" in
    start)
        load_config
        apply_hw_wakeup
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
            echo "Galaxy Wake Master is already running (PID: $(cat "$PID_FILE"))."
            exit 0
        fi
        nohup "$0" run >/dev/null 2>&1 &
        echo "Galaxy Wake Master daemon launched."
        ;;
    stop)
        pkill -f "com.galaxy.WakeSensor" 2>/dev/null || true
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" 2>/dev/null)
            pkill -P "$pid" 2>/dev/null
            kill -9 "$pid" 2>/dev/null
            rm -f "$PID_FILE"
            echo "Galaxy Wake Master stopped."
        else
            pkill -f "wake_master run" 2>/dev/null
            echo "Stopped."
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    run)
        daemon_run
        ;;
    apply_hw)
        load_config
        apply_hw_wakeup
        echo "Hardware sysfs wakeup applied."
        ;;
    wake)
        trigger_wake "Manual CLI Trigger"
        ;;
    sleep)
        trigger_sleep "Manual CLI Trigger"
        ;;
    power_menu)
        log_msg "Power menu requested via CLI"
        input keyevent --longpress 26 2>/dev/null || am broadcast -a android.intent.action.ACTION_SHOW_POWER_DIALOG 2>/dev/null || true
        ;;
    status)
        load_config
        if is_screen_on; then
            scr="AWAKE"
        else
            scr="ASLEEP"
        fi

        prox=$(read_cached_sensor "PROX")
        orient=$(read_cached_sensor "ORIENT")
        accel=$(read_cached_sensor "ACCEL")
        [ -z "$prox" ] && prox="0"
        [ -z "$orient" ] && orient="UNKNOWN"
        [ -z "$accel" ] && accel="0,0,0"

        echo "=========================================="
        echo " Galaxy Wake Master Status"
        echo "=========================================="
        echo "Screen State:        $scr"
        echo "Proximity:           $( [ "$prox" = "1" ] && echo "NEAR" || echo "FAR" )"
        echo "Device Orientation:  $orient"
        echo "Live Accel XYZ:      $accel"
        echo "Vol UP Wake:         $VOL_UP_WAKE"
        echo "Vol DOWN Wake:       $VOL_DOWN_WAKE"
        echo "Put-Down Sleep:      $PUT_DOWN_SLEEP"
        echo "Face-Down Sleep:     $FACE_DOWN_SLEEP"
        echo "Pocket Sleep:        $POCKET_SLEEP"
        echo "Flat-Table Sleep:    $FLAT_TABLE_SLEEP"
        echo "Sleep Delay:         ${SLEEP_DELAY}s"
        echo "Web UI Port:         $WEB_PORT"
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
            echo "Daemon Status:       RUNNING (PID $(cat "$PID_FILE"))"
        else
            echo "Daemon Status:       STOPPED"
        fi
        if pgrep -f "com.galaxy.WakeSensor" >/dev/null 2>&1; then
            echo "WakeSensor Engine:   ACTIVE (DEX PID $(pgrep -f "com.galaxy.WakeSensor" | head -n1))"
        else
            echo "WakeSensor Engine:   INACTIVE"
        fi
        echo "=========================================="
        ;;
    sensors)
        prox=$(read_cached_sensor "PROX")
        orient=$(read_cached_sensor "ORIENT")
        accel=$(read_cached_sensor "ACCEL")
        dist=$(read_cached_sensor "DIST")
        [ -z "$prox" ] && prox="0"
        [ -z "$orient" ] && orient="UNKNOWN"
        [ -z "$accel" ] && accel="0,0,0"
        [ -z "$dist" ] && dist="5.0"
        echo "Proximity: $prox (1=NEAR, 0=FAR)"
        echo "Accel XYZ: $accel"
        echo "Orientation: $orient"
        echo "Distance: ${dist}cm"
        ;;
    *)
        echo "Usage: wake_master {start|stop|restart|run|status|wake|sleep|power_menu|sensors|apply_hw}"
        exit 1
        ;;
esac

exit 0
